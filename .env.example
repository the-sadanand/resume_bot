# ===========================
# AI Resume Screening Bot
# Environment Configuration
# ===========================

# --- Application ---
APP_NAME=Resume Screening Bot
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# --- LLM Provider ---
# Options: ollama | openai | none
LLM_PROVIDER=none

# Ollama settings (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenAI settings (if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=

# --- Discord Bot ---
DISCORD_BOT_TOKEN=

# --- Google Chat ---
GOOGLE_CHAT_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=your_random_verify_token_here

# --- Database ---
DATABASE_URL=sqlite:///./data/resume_screening.db

# --- Redis (optional) ---
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# --- File Handling ---
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,docx
TEMP_DIR=./temp
GENERATED_DIR=./generated

# --- Scoring Weights (must sum to 100) ---
WEIGHT_SKILLS=35
WEIGHT_EXPERIENCE=20
WEIGHT_PROJECTS=15
WEIGHT_EDUCATION=10
WEIGHT_JD_MATCH=15
WEIGHT_COMPLETENESS=5

# --- Score Thresholds ---
THRESHOLD_STRONG=85
THRESHOLD_GOOD=70
THRESHOLD_MODERATE=55

# --- Embedding Model ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
SEMANTIC_SIMILARITY_THRESHOLD=0.65
